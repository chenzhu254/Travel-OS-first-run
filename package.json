{
  "name": "travel-os",
  "version": "0.1.0-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15.11.0 emulators:exec --project demo-travel-os --only database \"vitest run tests/database-rules.test.js\"",
    "firebase:rules:configure": "node scripts/firebase-deploy-boundary.mjs configure",
    "firebase:rules:deploy": "node scripts/firebase-deploy-boundary.mjs deploy",
    "firebase:functions:deploy": "node scripts/firebase-deploy-boundary.mjs deploy-functions",
    "test:watch": "vitest",
    "check": "npm run test -- --exclude tests/database-rules.test.js && node --check functions/index.js && npm run build"
  },
  "dependencies": {
    "firebase": "^12.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
